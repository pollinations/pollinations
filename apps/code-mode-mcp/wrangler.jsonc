{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pollinations-mcp-code-local",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "production": {
      "name": "pollinations-mcp-code",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true
      },
      "vars": {
        "POLLINATIONS_BASE_URL": "https://gen.pollinations.ai"
      },
      "worker_loaders": [
        {
          "binding": "LOADER"
        }
      ]
    },
    "staging": {
      "name": "pollinations-mcp-code-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true
      },
      "vars": {
        "POLLINATIONS_BASE_URL": "https://staging.gen.pollinations.ai"
      },
      "worker_loaders": [
        {
          "binding": "LOADER"
        }
      ]
    }
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "vars": {
    "POLLINATIONS_BASE_URL": "http://localhost:8788"
  }
}
