{
  // Private per-user computer for Pollinations agents. Reachable only through
  // gen.pollinations.ai's /mcp/computer proxy (service binding COMPUTER_MCP),
  // which authenticates the caller and sets x-pollinations-user-id.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pollinations-computer-mcp",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "observability": { "enabled": true },
  // Dynamic Worker loader: each shell exec runs just-bash in a fresh isolate.
  "worker_loaders": [{ "binding": "LOADER" }],
  // One Durable Object per Pollinations user id; its SQLite holds the filesystem.
  "durable_objects": {
    "bindings": [{ "name": "COMPUTER", "class_name": "Computer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Computer"] }],
  "env": {
    "staging": {
      "name": "pollinations-computer-mcp-staging",
      "workers_dev": false,
      "observability": { "enabled": true },
      "worker_loaders": [{ "binding": "LOADER" }],
      "durable_objects": {
        "bindings": [{ "name": "COMPUTER", "class_name": "Computer" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Computer"] }]
    }
  }
}
