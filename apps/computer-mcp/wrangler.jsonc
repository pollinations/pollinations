{
  // Private per-user computer for Pollinations agents. Reachable only through
  // gen.pollinations.ai's /mcp/computer proxy (service binding COMPUTER_MCP),
  // which authenticates the caller and sets x-pollinations-user-id.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pollinations-computer-mcp",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Computer",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 20,
      "rollout_active_grace_period": 0,
      "rollout_step_percentage": [100]
    }
  ],
  "services": [
    { "binding": "MEDIA", "service": "pollinations-media-prod", "entrypoint": "MediaUpload" }
  ],
  // One Durable Object per caller, agent and workspace; SQLite holds its files.
  "durable_objects": {
    "bindings": [{ "name": "COMPUTER", "class_name": "Computer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Computer"] }],
  "env": {
    "staging": {
      "name": "pollinations-computer-mcp-staging",
      "workers_dev": false,
      "observability": { "enabled": true },
      "containers": [
        {
          "class_name": "Computer",
          "image": "./Dockerfile",
          "instance_type": "standard-2",
          "max_instances": 5,
          "rollout_active_grace_period": 0,
          "rollout_step_percentage": [100]
        }
      ],
      "services": [
        { "binding": "MEDIA", "service": "pollinations-media-staging", "entrypoint": "MediaUpload" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "COMPUTER", "class_name": "Computer" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Computer"] }]
    }
  }
}
