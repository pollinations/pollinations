# Discord bot credentials (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-client-id

# Pollinations App Key (create at https://enter.pollinations.ai/keys)
POLLINATIONS_APP_KEY=pk_your_app_key

# Community Agent model ID (owner/name format)
AGENT_MODEL=pollinations/research-assistant
