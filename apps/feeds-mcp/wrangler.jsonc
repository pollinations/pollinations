{
    "name": "feeds-mcp",
    "account_id": "b6ec751c0862027ba269faf7029b2501",
    "main": "worker.js",
    "compatibility_date": "2026-08-14",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "routes": [
        {
            "pattern": "feeds-mcp.pollinations.ai",
            "zone_name": "pollinations.ai",
            "custom_domain": true
        }
    ],
    "observability": {
        "enabled": true
    },
    "env": {
        "staging": {
            "name": "feeds-mcp-staging",
            "workers_dev": true,
            "routes": [],
            "observability": {
                "enabled": true
            }
        }
    }
}
