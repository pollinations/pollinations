{
  "name": "jev",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "worker.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "jev.pollinations.ai",
      "zone_name": "pollinations.ai",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "jev-staging",
      // Reachable on workers.dev: the community endpoint calls this worker
      // directly with its registered bearer token, not through gen's zone.
      "workers_dev": true,
      "routes": [],
      "observability": { "enabled": true }
    }
  }
}
