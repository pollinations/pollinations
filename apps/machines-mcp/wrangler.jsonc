{
  // Lets Pollinations agents start and control real Linux sandboxes.
  // Reachable only through gen.pollinations.ai's /mcp/machines proxy
  // (service binding MACHINES_MCP), which authenticates the caller and
  // forwards the caller's API key for downstream sandbox billing.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pollinations-machines-mcp",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "routes": [
    {
      "pattern": "machines-mcp.pollinations.ai",
      "zone_name": "pollinations.ai",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "pollinations-machines-mcp-staging",
      // Keep direct staging access alongside the Gen service binding.
      "workers_dev": true,
      "routes": [],
      "vars": { "POLLINATIONS_BASE_URL": "https://staging.gen.pollinations.ai" },
      "observability": { "enabled": true }
    }
  }
}
