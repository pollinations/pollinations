# NPC Memory Agent — Environment Configuration
# Copy this file to .env and edit values

# Server
NPC_HOST=0.0.0.0
NPC_PORT=8080

# LLM
NPC_BASE_MODEL=openai
NPC_MEMORY_MODEL=openai
NPC_POLLINATIONS_API_BASE=https://gen.pollinations.ai/v1
NPC_CHAT_ENDPOINT=/chat/completions
NPC_EMBEDDINGS_ENDPOINT=/embeddings
NPC_POLLINATIONS_API_KEY=

# Memory
NPC_MAX_MEMORIES=100
NPC_MEMORY_PRUNE_DAYS=90

# Personality
NPC_PERSONALITY=warm,curious,playful
NPC_LANGUAGE=en

# Computer MCP
NPC_COMPUTER_MCP_URL=http://localhost:8787
NPC_COMPUTER_MCP_HEADER=x-pollinations-user-id

# Agent metadata
NPC_AGENT_NAME=npc-memory-agent
NPC_AGENT_TITLE=NPC Memory Agent
NPC_AGENT_DESCRIPTION=A friendly NPC companion who remembers you across conversations.

# UI
NPC_UI_BG=#1a1a2e
NPC_UI_FG=#eaeaea
NPC_UI_ACCENT=#e94560
NPC_UI_MUTED=#4a4a6a
NPC_UI_BUBBLE_BG=#16213e
NPC_UI_BUBBLE_FG=#eaeaea

# Security
NPC_CORS_ORIGINS=*
NPC_RATE_LIMIT=60/minute

# Logging
NPC_LOG_LEVEL=INFO
