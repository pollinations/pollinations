{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pollinations-optillm",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "worker.js",
  "workers_dev": false,
  "compatibility_date": "2026-09-01",
  "vars": { "GEN_BASE_URL": "https://gen.pollinations.ai/v1" },
  "containers": [
    {
      "class_name": "OptillmContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "OPTILLM", "class_name": "OptillmContainer" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OptillmContainer"] }
  ],
  "routes": [
    {
      "pattern": "optillm.pollinations.ai",
      "zone_name": "pollinations.ai",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "pollinations-optillm-staging",
      "workers_dev": false,
      "vars": { "GEN_BASE_URL": "https://staging.gen.pollinations.ai/v1" },
      "containers": [
        {
          "class_name": "OptillmContainer",
          "image": "./Dockerfile",
          "max_instances": 1,
          "instance_type": "standard-1"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "OPTILLM", "class_name": "OptillmContainer" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["OptillmContainer"] }
      ],
      "routes": [
        {
          "pattern": "optillm-staging.pollinations.ai",
          "zone_name": "pollinations.ai",
          "custom_domain": true
        }
      ],
      "observability": { "enabled": true }
    }
  }
}
