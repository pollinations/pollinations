{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "lib": ["ES2020"],
    "types": ["obsidian"]
  },
  "include": ["main.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
