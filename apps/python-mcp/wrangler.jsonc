{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pollinations-python-mcp",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "entrypoint.js",
  "workers_dev": false,
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "PythonContainer",
      "image": "./Dockerfile",
      "max_instances": 50,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PYTHON", "class_name": "PythonContainer" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PythonContainer"] }
  ],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "pollinations-python-mcp-staging",
      "workers_dev": false,
      "containers": [
        {
          "class_name": "PythonContainer",
          "image": "./Dockerfile",
          "max_instances": 5,
          "instance_type": "basic"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "PYTHON", "class_name": "PythonContainer" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["PythonContainer"] }
      ],
      "observability": { "enabled": true }
    }
  }
}
