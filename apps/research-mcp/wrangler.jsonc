{
  "name": "pollinations-research-mcp",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "worker.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "WIKIMEDIA_SOURCE", "class_name": "WikimediaSource" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WikimediaSource"] }],
  "env": {
    "staging": {
      "name": "pollinations-research-mcp-staging",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "durable_objects": {
        "bindings": [{
          "name": "WIKIMEDIA_SOURCE",
          "class_name": "WikimediaSource",
          "script_name": "pollinations-research-mcp"
        }]
      }
    }
  }
}
