{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pollinations-storage-mcp",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "entrypoint.js",
  "workers_dev": false,
  "compatibility_date": "2026-08-20",
  "services": [
    {
      "binding": "MEDIA",
      "service": "pollinations-media-prod"
    }
  ],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "pollinations-storage-mcp-staging",
      "workers_dev": false,
      "services": [
        {
          "binding": "MEDIA",
          "service": "pollinations-media-staging"
        }
      ],
      "observability": { "enabled": true }
    }
  }
}
