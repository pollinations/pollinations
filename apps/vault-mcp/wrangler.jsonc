{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pollinations-vault-mcp",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VAULT",
        "class_name": "Vault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Vault"
      ]
    }
  ],
  "env": {
    "staging": {
      "name": "pollinations-vault-mcp-staging",
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          {
            "name": "VAULT",
            "class_name": "Vault"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": [
            "Vault"
          ]
        }
      ]
    }
  }
}
