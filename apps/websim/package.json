{
    "name": "websim.pollinations.ai",
    "private": true,
    "version": "0.0.0",
    "description": "Worker-backed Websim app for generating shareable HTML pages with Pollinations.",
    "main": "worker.js",
    "type": "module",
    "scripts": {
        "dev": "npm run build && wrangler dev worker.js --local",
        "build": "vite build",
        "deploy": "npm run build && wrangler deploy worker.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@pollinations/sdk": "5.1.0-alpha.25",
        "@pollinations/ui": "0.1.0-alpha.25",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "vite": "^7.0.0",
        "wrangler": "^4.14.1"
    }
}
