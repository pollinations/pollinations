{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pollinations-weft-mcp",
  "account_id": "b6ec751c0862027ba269faf7029b2501",
  "main": "entrypoint.js",
  "workers_dev": false,
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "WEFT_API_URL": "https://weft.network/api/v1" },
  "env": {
    "staging": {
      "name": "pollinations-weft-mcp-staging",
      "workers_dev": false,
      "observability": { "enabled": true },
      "vars": { "WEFT_API_URL": "https://staging.weft.network/api/v1" }
    }
  }
}
