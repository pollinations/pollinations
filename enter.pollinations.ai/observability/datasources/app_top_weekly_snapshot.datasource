DESCRIPTION >
    Seven-day listed app ranking computed once per hour by app_top_weekly_refresh.

SCHEMA >
    `app_url` String `json:$.app_url`,
    `app_name` String `json:$.app_name`,
    `owner` String `json:$.owner`,
    `request_count` UInt64 `json:$.request_count`,
    `last_seen` DateTime `json:$.last_seen`

ENGINE MergeTree
ENGINE_SORTING_KEY app_url, app_name
