DESCRIPTION >
    Full UTC month Stripe Tax report totals by account and transaction currency.
    Reimports replace the effective report for the same account, month and currency.

TOKEN "operations_read" READ
TOKEN "operations_ingest" READ
TOKEN "operations_ingest" APPEND

SCHEMA >
    `account_id` String `json:$.account_id`,
    `month` String `json:$.month`,
    `currency` LowCardinality(String) `json:$.currency`,
    `tax_minor` Int64 `json:$.tax_minor`,
    `report_id` String `json:$.report_id`,
    `recorded_at` DateTime64(3) `json:$.recorded_at`

ENGINE MergeTree
ENGINE_SORTING_KEY account_id, month, currency
