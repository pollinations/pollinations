DESCRIPTION >
    Stripe adjustments linked to their original charge for purchase-month P&L.
    The balance transaction retains its actual Stripe activity timestamp.

TOKEN "operations_ingest" READ
TOKEN "operations_ingest" APPEND

SCHEMA >
    `account_id` String `json:$.account_id`,
    `transaction_id` String `json:$.transaction_id`,
    `charge_id` String `json:$.charge_id`,
    `purchase_month` String `json:$.purchase_month`,
    `recorded_at` DateTime64(3) `json:$.recorded_at`

ENGINE MergeTree
ENGINE_SORTING_KEY account_id, transaction_id
