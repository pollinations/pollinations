DESCRIPTION >
    Versioned monthly Stripe sales facts for the private Economics app.
    Values come from the authenticated Stripe account balance activity.

TOKEN "tinybird_read" READ
TOKEN "operations_ingest" APPEND
TOKEN "operations_ingest" READ

SCHEMA >
    `entry_id` String `json:$.entry_id`,
    `month` LowCardinality(String) `json:$.month`,
    `currency` LowCardinality(String) `json:$.currency`,
    `revenue_stream` LowCardinality(String) `json:$.revenue_stream` DEFAULT '',
    `gross_sales` Float64 `json:$.gross_sales`,
    `refunds` Float64 `json:$.refunds`,
    `reversals` Float64 `json:$.reversals` DEFAULT 0,
    `stripe_fees` Float64 `json:$.stripe_fees`,
    `payments` UInt64 `json:$.payments`,
    `refund_count` UInt64 `json:$.refund_count`,
    `coverage_end` Nullable(DateTime64(3)) `json:$.coverage_end`,
    `expected_accounts` UInt16 `json:$.expected_accounts` DEFAULT 0,
    `recorded_at` DateTime64(3) `json:$.recorded_at`

ENGINE MergeTree
ENGINE_PARTITION_KEY toYYYYMM(toDate(concat(month, '-01')))
ENGINE_SORTING_KEY entry_id, recorded_at
