DESCRIPTION >
    Canonical Economics vendor ledger. Stores compute and infrastructure
    usage, funding, account balance snapshots, and append-only corrections per entry_id.

TOKEN "operations_ingest" APPEND
TOKEN "operations_ingest" READ

SCHEMA >
    `entry_id` String `json:$.entry_id`,
    `source` String `json:$.source`,
    `vendor` String `json:$.vendor`,
    `account_id` Nullable(String) `json:$.account_id`,
    `account_name` Nullable(String) `json:$.account_name`,
    `type` String `json:$.type`,
    `start` String `json:$.start`,
    `end` String `json:$.end`,
    `credit` Float64 `json:$.credit`,
    `paid` Float64 `json:$.paid`,
    `currency` String `json:$.currency`,
    `resource_id` String `json:$.resource_id`,
    `resource_name` String `json:$.resource_name`,
    `resource_sku` String `json:$.resource_sku`,
    `resource_count` Float64 `json:$.resource_count`,
    `model` String `json:$.model`,
    `evidence` String `json:$.evidence`,
    `statement_amount` Nullable(Float64) `json:$.statement_amount`,
    `compared_entry_ids` Array(String) `json:$.compared_entry_ids[:]` DEFAULT [],
    `comparison_month` String `json:$.comparison_month` DEFAULT '',
    `comparison_basis` String `json:$.comparison_basis` DEFAULT '',
    `plan_amount` Nullable(Float64) `json:$.plan_amount`,
    `plan_category` String `json:$.plan_category` DEFAULT '',
    `plan_cadence` String `json:$.plan_cadence` DEFAULT '',
    `settled_by_entry_ids` Array(String) `json:$.settled_by_entry_ids[:]` DEFAULT [],
    `recorded_at` DateTime64(3) `json:$.recorded_at`

ENGINE MergeTree
ENGINE_SORTING_KEY entry_id, recorded_at
