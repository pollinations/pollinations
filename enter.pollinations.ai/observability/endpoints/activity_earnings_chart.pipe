DESCRIPTION >
    Activity developer earnings chart data grouped by date, entity, and source
    from materialized earning events.
    Use 'since' and 'until' for date range filtering.
    Use 'timezone' for calendar bounds and daily buckets; defaults to UTC.
    Hourly buckets are UTC instants, anchored at 'since' in the chosen timezone.

TOKEN "tinybird_read" READ

NODE activity_earnings_chart_node
SQL >
    %
    WITH
        {% if defined(since) %}
            toUnixTimestamp(toDateTime({{ String(since) }}, {{ String(timezone, 'UTC') }}))
        {% else %} 0 {% end %} AS bucket_origin
    -- Inner scope uses *_sum aliases so aggregate aliases never shadow the
    -- source columns (ClickHouse rejects a shadowed alias inside sumIf).
    SELECT
        date,
        entity_id,
        entity_name,
        source,
        requests,
        paid_requests,
        tier_requests,
        baseline_price_sum AS baseline_price,
        pollen_earned_sum AS pollen_earned,
        paid_earned,
        tier_earned,
        price_sum AS cost_usd,
        reward_rate_avg AS reward_rate
    FROM (
        SELECT
            if(
                {{ String(grain, 'day') }} = 'hour',
                formatDateTime(
                    toDateTime(bucket_origin + intDiv(toUnixTimestamp(event_timestamp) - bucket_origin, 3600) * 3600, 'UTC'),
                    '%F %T', 'UTC'
                ),
                formatDateTime(event_timestamp, '%F', {{ String(timezone, 'UTC') }})
            ) AS date,
            entity_id,
            entity_name,
            source,
            count() AS requests,
            countIf(meter_source = 'pack') AS paid_requests,
            countIf(meter_source = 'tier') AS tier_requests,
            sum(baseline_price) AS baseline_price_sum,
            sum(pollen_earned) AS pollen_earned_sum,
            sumIf(pollen_earned, meter_source = 'pack') AS paid_earned,
            sumIf(pollen_earned, meter_source = 'tier') AS tier_earned,
            sum(price_usd) AS price_sum,
            avg(reward_rate) AS reward_rate_avg
        FROM (
            SELECT
                any(timestamp) AS event_timestamp,
                source,
                entity_id,
                any(entity_name) AS entity_name,
                any(meter_source) AS meter_source,
                any(baseline_price) AS baseline_price,
                any(pollen_earned) AS pollen_earned,
                any(price_usd) AS price_usd,
                any(reward_rate) AS reward_rate
            FROM activity_earnings_events
            WHERE
                dev_user_id = {{ String(dev_user_id, '') }}
                {% if defined(since) %} AND timestamp >= toDateTime({{ String(since) }}, {{ String(timezone, 'UTC') }}) {% end %}
                {% if defined(until) %} AND timestamp < toDateTime({{ String(until) }}, {{ String(timezone, 'UTC') }}) {% end %}
            GROUP BY dev_user_id, source, entity_id, event_id
        )
        GROUP BY date, entity_id, entity_name, source
    )
    ORDER BY date DESC, entity_id, entity_name, source

TYPE endpoint
