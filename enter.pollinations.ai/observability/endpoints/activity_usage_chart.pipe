DESCRIPTION >
    Activity API usage chart data grouped by date/hour, API key, model, and meter source.

TOKEN "tinybird_read" READ

NODE activity_usage_chart_node
SQL >
    %
    SELECT
        if(
            {{ String(grain, 'day') }} = 'hour',
            formatDateTime(event_timestamp, '%F %H:00:00', {{ String(timezone, 'UTC') }}),
            formatDateTime(event_timestamp, '%F', {{ String(timezone, 'UTC') }})
        ) as date,
        api_key_id,
        nullIf(nullIf(api_key, ''), 'undefined') as api_key,
        resolved_model as model,
        meter_source,
        count() as requests,
        sum(price_usd) as cost_usd
    FROM (
        SELECT
            any(timestamp) AS event_timestamp,
            any(api_key_id) AS api_key_id,
            any(api_key) AS api_key,
            any(resolved_model) AS resolved_model,
            any(meter_source) AS meter_source,
            any(price_usd) AS price_usd
        FROM activity_usage_events
        WHERE
            user_id = {{ String(user_id, '') }}
            {% if defined(since) %} AND timestamp >= toDateTime({{ String(since) }}, {{ String(timezone, 'UTC') }}) {% end %}
            {% if defined(until) %} AND timestamp < toDateTime({{ String(until) }}, {{ String(timezone, 'UTC') }}) {% end %}
            {% if defined(api_key_ids) %} AND activity_usage_events.api_key_id IN {{ Array(api_key_ids, 'String') }} {% end %}
        GROUP BY user_id, event_id
    )
    GROUP BY date, api_key_id, api_key, model, meter_source
    ORDER BY date DESC, requests DESC, model, meter_source, api_key_id

TYPE endpoint
