DESCRIPTION >
    Get request counts per BYOP app in the last 24 hours.
    Requests through an App Key count for the catalog listing credited by
    app_key_listings: its URL and owner's GitHub ID. Requests without an App
    Key count for the key's hostname (key name heuristic) with an empty GitHub
    ID.
    Counts ALL requests through a BYOP app's API key, regardless of end user.

TOKEN tinybird_read READ

NODE app_byop_request_counts_node
SQL >
    SELECT
        apps.app_url AS app_url,
        if(ge.api_key_client_id IN ('', 'undefined'), ge.api_key_name, '') AS hostname,
        apps.github_user_id AS github_user_id,
        count() AS requests
    FROM generation_event_v2 ge
    LEFT JOIN app_key_listings apps
        ON ge.api_key_client_id = apps.app_key_id
    WHERE ge.start_time > now() - INTERVAL 1 DAY
    AND ge.is_final  -- one row per request; attempts counted separately
      AND (
        ge.api_key_created_via = 'redirect-auth'
        OR (ge.api_key_type = 'secret' AND ge.api_key_name LIKE '%.%')
      )
      AND (app_url != '' OR hostname != '')
    GROUP BY app_url, hostname, github_user_id
    HAVING requests > 0

TYPE endpoint
