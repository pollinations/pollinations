DESCRIPTION >
    Listed apps ranked by successful, billable Pollen Pay (BYOP) requests in
    the rolling last 7 days. A registered App Key must map to exactly one
    catalog listing with the same owner and a matching URL or callback below
    that URL. Ambiguous matches are excluded, not credited to every app on a
    shared host. Multiple keys for one listing are combined before ranking.
    Returns catalog URLs and names, public owner handles, and aggregate counts
    only. No user IDs, App Keys, wallet, revenue, or cost data is exposed.

TOKEN "tinybird_read_public" READ
TOKEN "tinybird_read" READ

NODE banned_users
SQL >
    SELECT id AS user_id
    FROM d1_user
    WHERE synced_at = (SELECT max(synced_at) FROM d1_user) AND banned = 1
    GROUP BY id

NODE latest_users
SQL >
    SELECT id AS user_id, toString(github_id) AS github_user_id
    FROM d1_user
    WHERE synced_at = (SELECT max(synced_at) FROM d1_user) AND banned = 0

NODE registered_apps
SQL >
    SELECT
        id AS app_key_id,
        user_id AS owner_user_id,
        arrayJoin(
            JSONExtract(coalesce(metadata, '{}'), 'redirectUris', 'Array(String)')
        ) AS redirect_uri
    FROM d1_apikey
    WHERE
        synced_at = (SELECT max(synced_at) FROM d1_apikey)
        AND prefix = 'pk'
        AND JSONExtractString(metadata, 'keyType') = 'publishable'

NODE catalog_apps
SQL >
    SELECT
        name, web_url, github_user_id, github_username, replaceRegexpOne(web_url, '/+$', '') AS base_url
    FROM app_directory
    WHERE
        github_user_id != ''
        AND name != ''
        AND (startsWith(web_url, 'https://') OR startsWith(web_url, 'http://'))

NODE matched_apps
SQL >
    SELECT
        registered.app_key_id,
        any (catalog.web_url) AS app_url,
        any (catalog.name) AS app_name,
        any (catalog.github_username) AS owner
    FROM registered_apps registered
    INNER JOIN latest_users users ON registered.owner_user_id = users.user_id
    INNER JOIN catalog_apps catalog ON users.github_user_id = catalog.github_user_id
    WHERE
        registered.redirect_uri = catalog.base_url
        OR startsWith(registered.redirect_uri, concat(catalog.base_url, '/'))
        OR startsWith(registered.redirect_uri, concat(catalog.base_url, '?'))
        OR startsWith(registered.redirect_uri, concat(catalog.base_url, '#'))
    GROUP BY registered.app_key_id
    HAVING uniqExact(tuple(catalog.web_url, catalog.name)) = 1

NODE app_top_weekly_node
SQL >
    %
    SELECT
        apps.app_url,
        apps.app_name, any (apps.owner) AS owner,
        count() AS request_count,
        max(requests.start_time) AS last_seen
    FROM generation_event_v2 requests
    INNER JOIN matched_apps apps ON requests.api_key_client_id = apps.app_key_id
    WHERE
        requests.start_time > now() - INTERVAL 7 DAY
        AND requests.start_time <= now()
        AND requests.environment = 'production'
        AND requests.api_key_created_via = 'redirect-auth'
        AND requests.is_final
        AND requests.is_billed_usage
        AND requests.response_status >= 200
        AND requests.response_status < 300
        AND requests.total_price > 0
        AND requests.user_id NOT IN (SELECT user_id FROM banned_users)
    GROUP BY apps.app_url, apps.app_name
    ORDER BY request_count DESC, last_seen DESC, app_name ASC, app_url ASC
    LIMIT {{ UInt8(limit, 10) }}

TYPE ENDPOINT
