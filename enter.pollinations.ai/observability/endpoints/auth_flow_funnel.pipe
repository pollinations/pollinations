DESCRIPTION >
    Two pre-login funnels by day, each counted per flow and dated by when the
    flow started, so a flow that crosses midnight is not split and a stage can
    never exceed the one above it.
    Browser sign-in: tabs that arrived signed out, and the share that became
    signed in within window_minutes of their last signed-out view. A tab is a
    per-tab id in sessionStorage, so two tabs never share a flow. Tabs that saw
    /app/sign-in are excluded: that flow hands the browser to the requesting
    app right after GitHub, so the tab never reports a signed-in view and would
    always look abandoned.
    Device authorization: codes issued to a CLI, then approved or denied in
    the browser, then collected as a token. client_id narrows the device side
    to one app. Consent grants and Discord linking are plain event counts;
    read them from product_analytics_daily.

TOKEN tinybird_read READ

NODE sign_in_flows
SQL >
    %
    SELECT
        flow_id,
        min(timestamp) AS started_at,
        maxIf(timestamp, user_id = '') AS last_anon_at,
        minIf(timestamp, user_id != '') AS identified_at
    FROM product_event
    WHERE environment = {{String(environment, 'production')}}
        AND event = 'page_viewed'
        AND flow_id != ''
        AND timestamp >= now() - toIntervalDay(least(greatest({{Int32(days, 30)}}, 1), 366))
    GROUP BY flow_id
    HAVING countIf(user_id = '') > 0
        AND countIf(page = '/app/sign-in') = 0

NODE sign_in_daily
SQL >
    %
    SELECT
        toDate(started_at) AS date,
        uniq(flow_id) AS signed_out_tabs,
        uniqIf(
            flow_id,
            identified_at > last_anon_at
                AND dateDiff('minute', last_anon_at, identified_at) <= least(greatest({{Int32(window_minutes, 30)}}, 1), 1440)
        ) AS signed_in,
        if(signed_out_tabs = 0, 0, round(100 * signed_in / signed_out_tabs, 1)) AS pct_signed_in
    FROM sign_in_flows
    GROUP BY date

NODE device_daily
SQL >
    %
    SELECT
        toDate(started_at) AS date,
        uniqIf(flow_id, issued > 0) AS device_code_issued,
        uniqIf(flow_id, approved > 0) AS device_approved,
        uniqIf(flow_id, denied > 0) AS device_denied,
        uniqIf(flow_id, token > 0) AS device_token_issued,
        if(device_code_issued = 0, 0, round(100 * device_approved / device_code_issued, 1)) AS pct_device_approved,
        if(device_approved = 0, 0, round(100 * device_token_issued / device_approved, 1)) AS pct_device_token_issued
    FROM (
        SELECT
            flow_id,
            min(timestamp) AS started_at,
            countIf(event = 'device_code_issued') AS issued,
            countIf(event = 'device_approved') AS approved,
            countIf(event = 'device_denied') AS denied,
            countIf(event = 'device_token_issued') AS token
        FROM product_event
        WHERE environment = {{String(environment, 'production')}}
            AND event IN ('device_code_issued', 'device_approved', 'device_denied', 'device_token_issued')
            AND flow_id != ''
            AND timestamp >= now() - toIntervalDay(least(greatest({{Int32(days, 30)}}, 1), 366))
            {% if defined(client_id) %}
            AND client_id = {{String(client_id)}}
            {% end %}
        GROUP BY flow_id
    )
    GROUP BY date

NODE funnel
SQL >
    SELECT
        greatest(s.date, d.date) AS date,
        s.signed_out_tabs AS signed_out_tabs,
        s.signed_in AS signed_in,
        s.pct_signed_in AS pct_signed_in,
        d.device_code_issued AS device_code_issued,
        d.device_approved AS device_approved,
        d.device_denied AS device_denied,
        d.device_token_issued AS device_token_issued,
        d.pct_device_approved AS pct_device_approved,
        d.pct_device_token_issued AS pct_device_token_issued
    FROM sign_in_daily s
    FULL OUTER JOIN device_daily d ON s.date = d.date
    ORDER BY date

TYPE endpoint
