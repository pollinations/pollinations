DESCRIPTION >
    Cloudflare page views per UTC day, host, page, country, device and browser from
    cloudflare_traffic_raw, using the latest fetch of each day. requests counts page loads,
    visits arrivals from another site or a direct link. bot_category is empty for traffic
    Cloudflare does not recognise as a verified bot. Sampled estimates, no referrer.

TOKEN "tinybird_read" READ

NODE latest_fetch
SQL >
    SELECT date, argMax(body, fetched_at) AS body
    FROM cloudflare_traffic_raw
    WHERE dataset = 'page_views'
    GROUP BY date

NODE cloudflare_page_views_daily_node
SQL >
    SELECT
        date,
        JSONExtractString(g, 'dimensions', 'clientRequestHTTPHost') AS host,
        JSONExtractString(g, 'dimensions', 'clientRequestPath') AS page,
        JSONExtractString(g, 'dimensions', 'clientCountryName') AS country,
        JSONExtractString(g, 'dimensions', 'clientDeviceType') AS device,
        JSONExtractString(g, 'dimensions', 'userAgentBrowser') AS browser,
        JSONExtractString(g, 'dimensions', 'verifiedBotCategory') AS bot_category,
        JSONExtractUInt(g, 'count') AS requests,
        JSONExtractUInt(g, 'sum', 'visits') AS visits
    FROM latest_fetch
    ARRAY JOIN
        JSONExtractArrayRaw(body, 'data', 'viewer', 'zones', 1, 'httpRequestsAdaptiveGroups') AS g
    ORDER BY date, host, page, requests DESC

TYPE endpoint
