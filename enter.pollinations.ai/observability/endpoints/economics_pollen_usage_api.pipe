DESCRIPTION >
    Canonical Pollen economics endpoint backed only by the
    economics_pollen_usage materialization. The March 2026 flux and zimage
    io.net label is normalized to vast.ai at the documented registry cutover.

TOKEN "operations_read" READ

NODE endpoint
SQL >
    SELECT
        month,
        vendor,
        model,
        'USD' AS currency,
        if(vendor = 'community', 0, sum(cost_paid)) AS cost_paid,
        if(vendor = 'community', 0, sum(cost_quests)) AS cost_quests,
        sum(price_paid) AS price_paid,
        sum(price_quests) AS price_quests,
        sum(byop_paid) AS byop_paid,
        sum(byop_quests) AS byop_quests,
        sum(model_paid) AS model_paid,
        sum(model_quests) AS model_quests,
        sum(requests_paid) AS requests_paid,
        sum(requests_quests) AS requests_quests
    FROM
    (
        SELECT
            month,
            if(
                month = '2026-03'
                AND vendor = 'io.net'
                AND model IN ('flux', 'zimage'),
                'vast.ai',
                vendor
            ) AS vendor,
            model,
            sumMerge(cost_paid) AS cost_paid,
            sumMerge(cost_quests) AS cost_quests,
            sumMerge(price_paid) AS price_paid,
            sumMerge(price_quests) AS price_quests,
            sumMerge(byop_paid) AS byop_paid,
            sumMerge(byop_quests) AS byop_quests,
            sumMerge(model_paid) AS model_paid,
            sumMerge(model_quests) AS model_quests,
            sumMerge(requests_paid) AS requests_paid,
            sumMerge(requests_quests) AS requests_quests
        FROM economics_pollen_usage
        GROUP BY month, vendor, model
    )
    GROUP BY month, vendor, model
    HAVING
        cost_paid != 0
        OR cost_quests != 0
        OR price_paid != 0
        OR price_quests != 0
        OR byop_paid != 0
        OR byop_quests != 0
        OR model_paid != 0
        OR model_quests != 0
        OR requests_paid != 0
        OR requests_quests != 0
    ORDER BY month DESC, vendor, model

TYPE ENDPOINT
