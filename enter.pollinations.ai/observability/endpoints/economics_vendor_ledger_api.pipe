DESCRIPTION >
    Effective canonical vendor ledger. Corrections
    re-append the same entry_id; explicit and legacy tombstones remain hidden.

TOKEN "operations_read" READ

NODE endpoint
SQL >
    SELECT
        entry_id,
        tupleElement(latest, 1) AS source,
        tupleElement(latest, 2) AS start,
        tupleElement(latest, 3) AS end,
        tupleElement(latest, 4) AS vendor,
        ifNull(tupleElement(latest, 5), '') AS account_id,
        ifNull(tupleElement(latest, 6), '') AS account_name,
        tupleElement(latest, 7) AS type,
        tupleElement(latest, 8) AS model,
        tupleElement(latest, 9) AS credit,
        tupleElement(latest, 10) AS paid,
        tupleElement(latest, 11) AS currency,
        tupleElement(latest, 12) AS evidence,
        formatDateTime(tupleElement(latest, 17), '%F %T.%f') AS recorded_at,
        tupleElement(latest, 13) AS resource_sku,
        tupleElement(latest, 14) AS resource_count,
        tupleElement(latest, 15) AS resource_id,
        tupleElement(latest, 16) AS resource_name,
        tupleElement(latest, 18) AS statement_amount,
        tupleElement(latest, 19) AS compared_entry_ids,
        tupleElement(latest, 20) AS comparison_month,
        tupleElement(latest, 21) AS comparison_basis,
        tupleElement(latest, 22) AS plan_amount,
        tupleElement(latest, 23) AS plan_category,
        tupleElement(latest, 24) AS plan_cadence,
        tupleElement(latest, 25) AS settled_by_entry_ids
    FROM
    (
        SELECT
            entry_id,
            argMax(
                tuple(
                    source,
                    start,
                    end,
                    vendor,
                    account_id,
                    account_name,
                    type,
                    model,
                    credit,
                    paid,
                    currency,
                    evidence,
                    resource_sku,
                    resource_count,
                    resource_id,
                    resource_name,
                    recorded_at,
                    statement_amount,
                    compared_entry_ids,
                    comparison_month,
                    comparison_basis,
                    plan_amount,
                    plan_category,
                    plan_cadence,
                    settled_by_entry_ids
                ),
                recorded_at
            ) AS latest
        FROM economics_vendor_ledger
        GROUP BY entry_id
    )
    WHERE
        source != 'tombstone'
        AND positionCaseInsensitive(evidence, 'superseded') = 0
    ORDER BY start DESC, vendor, type, resource_name, resource_id

TYPE ENDPOINT
