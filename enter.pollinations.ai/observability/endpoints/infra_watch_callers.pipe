TOKEN infra_watch_read READ

DESCRIPTION >
    infra-watch monitor: how one model's final 5xx failures spread over
    callers, as counts only (no user or key ids). Shows whether a single
    caller explains an alert. Failures are counted per traffic group, and a
    caller is one account within one group, so an account that mixes groups
    is never attributed to the wrong one. Read by the infra-watch Worker's
    caller_spread tool.

NODE infra_watch_callers_node
SQL >
    %
    SELECT
        sum(bucket_requests) AS requests,
        sum(bucket_failures) AS failures,
        uniq(user_id) AS callers,
        uniqIf(user_id, bucket_failures > 0) AS failing_callers,
        sumIf(bucket_failures, traffic_group = 'regular') AS failures_regular,
        sumIf(bucket_failures, traffic_group = 'legacy') AS failures_legacy,
        sumIf(bucket_failures, traffic_group = 'operations') AS failures_operations,
        sumIf(bucket_failures, traffic_group = 'dev') AS failures_dev,
        max(bucket_failures) AS top_caller_failures,
        argMax(traffic_group, bucket_failures) AS top_caller_group
    FROM (
        SELECT
            user_id,
            traffic_group,
            count() AS bucket_requests,
            countIf(response_status >= 500) AS bucket_failures
        FROM generation_events_classified
        WHERE start_time >= now() - interval least(greatest({{Int32(minutes, 15)}}, 1), 60) minute
            AND is_final
            AND resolved_model_requested = {{String(model, required=True)}}
        GROUP BY user_id, traffic_group
    )

TYPE endpoint
