TOKEN infra_watch_read READ

DESCRIPTION >
    infra-watch monitor: recent server errors, newest first, with safe fields
    only. No prompts, user ids, key ids, headers or stack traces; messages and
    provider bodies are cut to 300 characters. Read by the infra-watch
    Worker's recent_errors tool.

NODE infra_watch_errors_node
SQL >
    %
    SELECT
        timestamp,
        request_id,
        route_path,
        status,
        error_code,
        error_class,
        substringUTF8(message, 1, 300) AS message,
        upstream_host,
        upstream_status,
        substringUTF8(upstream_body, 1, 300) AS upstream_body,
        model_requested,
        resolved_model_requested,
        edge_colo,
        duration_ms
    FROM error_event
    WHERE timestamp >= now() - interval least(greatest({{Int32(minutes, 15)}}, 1), 60) minute
    {% if defined(model) %}
        AND (
            resolved_model_requested = {{String(model)}}
            OR model_requested = {{String(model)}}
        )
    {% end %}
    ORDER BY timestamp DESC
    LIMIT least(greatest({{Int32(limit, 20)}}, 1), 20)

TYPE endpoint
