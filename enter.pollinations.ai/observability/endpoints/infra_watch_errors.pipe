TOKEN infra_watch_read READ

DESCRIPTION >
    infra-watch monitor: server errors of the last 60 minutes at most, grouped
    by kind (model, route, status, error code, provider), largest first. Each
    group has its count, first and last time seen, median duration and its
    newest example. Safe fields only: no prompts, user ids, key ids, headers
    or stack traces; messages and provider bodies are cut to 300 characters.
    Read by the infra-watch Worker's recent_errors tool.

NODE infra_watch_errors_node
SQL >
    %
    SELECT
        count() AS errors,
        min(timestamp) AS first_seen,
        max(timestamp) AS last_seen,
        resolved_model_requested AS model,
        route_path,
        status,
        error_code,
        error_class,
        upstream_host,
        upstream_status,
        round(quantile(0.5)(duration_ms)) AS duration_p50_ms,
        argMax(request_id, timestamp) AS example_request_id,
        substringUTF8(argMax(message, timestamp), 1, 300) AS example_message,
        substringUTF8(argMax(upstream_body, timestamp), 1, 300) AS example_upstream_body
    FROM error_event
    WHERE timestamp >= now() - interval least(greatest({{Int32(minutes, 15)}}, 1), 60) minute
    {% if defined(model) %}
        AND (
            resolved_model_requested = {{String(model)}}
            OR model_requested = {{String(model)}}
        )
    {% end %}
    GROUP BY
        model,
        route_path,
        status,
        error_code,
        error_class,
        upstream_host,
        upstream_status
    ORDER BY errors DESC
    LIMIT 20

TYPE endpoint
