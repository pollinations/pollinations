TOKEN infra_watch_read READ

DESCRIPTION >
    infra-watch monitor: the daily community text leaderboard. One row per
    community text model over the last 24 hours: final requests, tokens
    served, median completion tokens per second and success without caller
    4xx. Every model is returned so the leaderboard can count totals; it
    ranks only the busy ones. Read by operations/infra-watch/leaderboard.

NODE infra_watch_text_leaderboard_node
SQL >
    SELECT
        replaceRegexpOne(model_requested, '^community/', '') AS model,
        count() AS requests,
        sum(token_count_prompt_text + token_count_prompt_cached + token_count_completion_text + token_count_completion_reasoning) AS total_tokens,
        round(medianIf((token_count_completion_text + token_count_completion_reasoning) / (response_time / 1000), response_status < 300 AND response_time > 0 AND token_count_completion_text + token_count_completion_reasoning >= 20), 1) AS median_tps,
        round(100 * countIf(response_status >= 200 AND response_status < 300) / greatest(countIf(response_status < 400 OR response_status >= 500), 1), 2) AS success
    FROM generation_event_v2
    WHERE start_time > now() - INTERVAL 24 HOUR
        AND event_type = 'generate.text'
        AND model_provider_used = 'community'
        AND is_final
    GROUP BY model
    ORDER BY total_tokens DESC

TYPE endpoint
