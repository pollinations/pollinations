TOKEN "operations_read" READ

NODE endpoint
SQL >
    SELECT
        entry_id,
        formatDateTime(tupleElement(latest, 1), '%F') AS month,
        tupleElement(latest, 2) AS vendor,
        tupleElement(latest, 3) AS category,
        tupleElement(latest, 4) AS amount,
        tupleElement(latest, 5) AS currency,
        tupleElement(latest, 6) AS method,
        tupleElement(latest, 7) AS source,
        tupleElement(latest, 8) AS evidence,
        toString(tupleElement(latest, 9)) AS recorded_at
    FROM
    (
        SELECT
            entry_id,
            argMax(
                tuple(
                    month,
                    vendor,
                    category,
                    amount,
                    currency,
                    method,
                    source,
                    evidence,
                    recorded_at
                ),
                recorded_at
            ) AS latest
        FROM op_forecast
        GROUP BY entry_id
    )
    ORDER BY month, vendor, category, entry_id

TYPE ENDPOINT
