DESCRIPTION >
    op_pollen: product usage in Pollen with paid/quest splits, computed directly
    from generation_event_v2. Reads the pre-aggregated op_pollen (cost/price/
    requests and byop/model payouts, per month/provider/model) instead of
    scanning raw event history. Community cost is normalized to zero because
    the owner payout is recorded separately in model_paid/model_quests. The
    March 2026 flux/zimage io.net label is
    normalized to vast.ai because it changed exactly at the registry deployment
    cutover while io.net billing had already ended; archived evidence:
    https://drive.google.com/file/d/1Qfy7u2glbstdNe3gPQcoYL_bN5PjjOuB/view?usp=drivesdk

TOKEN "operations_read" READ

NODE endpoint
SQL >
    SELECT
        month,
        vendor,
        model,
        'USD' AS currency,
        if(vendor = 'community', 0, if(max(replaces_base) = 1, sumIf(cost_paid, replaces_base = 1), sum(cost_paid))) AS cost_paid,
        if(vendor = 'community', 0, if(max(replaces_base) = 1, sumIf(cost_quests, replaces_base = 1), sum(cost_quests))) AS cost_quests,
        if(max(replaces_base) = 1, sumIf(price_paid, replaces_base = 1), sum(price_paid)) AS price_paid,
        if(max(replaces_base) = 1, sumIf(price_quests, replaces_base = 1), sum(price_quests)) AS price_quests,
        if(max(replaces_base) = 1, sumIf(byop_paid, replaces_base = 1), sum(byop_paid)) AS byop_paid,
        if(max(replaces_base) = 1, sumIf(byop_quests, replaces_base = 1), sum(byop_quests)) AS byop_quests,
        if(max(replaces_base) = 1, sumIf(model_paid, replaces_base = 1), sum(model_paid)) AS model_paid,
        if(max(replaces_base) = 1, sumIf(model_quests, replaces_base = 1), sum(model_quests)) AS model_quests,
        if(max(replaces_base) = 1, sumIf(requests_paid, replaces_base = 1), sum(requests_paid)) AS requests_paid,
        if(max(replaces_base) = 1, sumIf(requests_quests, replaces_base = 1), sum(requests_quests)) AS requests_quests
    FROM
    (
        SELECT
            month,
            if(
                month = '2026-03'
                AND provider = 'io.net'
                AND model IN ('flux', 'zimage'),
                'vast.ai',
                provider
            ) AS vendor,
            model,
            0 AS replaces_base,
            sumMerge(cost_paid) AS cost_paid,
            sumMerge(cost_quests) AS cost_quests,
            sumMerge(price_paid) AS price_paid,
            sumMerge(price_quests) AS price_quests,
            sumMerge(byop_paid) AS byop_paid,
            sumMerge(byop_quests) AS byop_quests,
            sumMerge(model_paid) AS model_paid,
            sumMerge(model_quests) AS model_quests,
            sumMerge(requests_paid) AS requests_paid,
            sumMerge(requests_quests) AS requests_quests
        FROM op_pollen
        GROUP BY month, provider, model

        UNION ALL

        SELECT
            tupleElement(latest, 1) AS month,
            if(
                tupleElement(latest, 1) = '2026-03'
                AND tupleElement(latest, 2) = 'io.net'
                AND tupleElement(latest, 3) IN ('flux', 'zimage'),
                'vast.ai',
                tupleElement(latest, 2)
            ) AS vendor,
            tupleElement(latest, 3) AS model,
            toUInt8(tupleElement(latest, 4) = 'workspace_snapshot') AS replaces_base,
            tupleElement(latest, 5) AS cost_paid,
            tupleElement(latest, 6) AS cost_quests,
            tupleElement(latest, 7) AS price_paid,
            tupleElement(latest, 8) AS price_quests,
            tupleElement(latest, 9) AS byop_paid,
            tupleElement(latest, 10) AS byop_quests,
            tupleElement(latest, 11) AS model_paid,
            tupleElement(latest, 12) AS model_quests,
            tupleElement(latest, 13) AS requests_paid,
            tupleElement(latest, 14) AS requests_quests
        FROM
        (
            SELECT
                entry_id,
                argMax(
                    tuple(
                        month,
                        provider,
                        model,
                        reason,
                        cost_paid,
                        cost_quests,
                        price_paid,
                        price_quests,
                        byop_paid,
                        byop_quests,
                        model_paid,
                        model_quests,
                        requests_paid,
                        requests_quests,
                        evidence
                    ),
                    recorded_at
                ) AS latest
            FROM op_pollen_history
            GROUP BY entry_id
        )
        WHERE tupleElement(latest, 4) != 'tombstone'
    )
    GROUP BY month, vendor, model
    HAVING
        cost_paid != 0
        OR cost_quests != 0
        OR price_paid != 0
        OR price_quests != 0
        OR byop_paid != 0
        OR byop_quests != 0
        OR model_paid != 0
        OR model_quests != 0
        OR requests_paid != 0
        OR requests_quests != 0
    ORDER BY month DESC, vendor, model

TYPE ENDPOINT
