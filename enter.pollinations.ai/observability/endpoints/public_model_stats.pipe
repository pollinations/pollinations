DESCRIPTION >
    Public model usage statistics over seven days, refreshed hourly.
    Preserves median successful priced costs and visibility requiring at least
    three successful requests from two callers. Reads the shared snapshot so
    direct public callers do not rerun the raw-history aggregation.

TOKEN tinybird_read_public READ

NODE endpoint
SQL >
    %
    SELECT
        model,
        request_count,
        success_count,
        priced_success_count,
        user_count,
        avg_cost_usd,
        avg_response_ms,
        error_count
    FROM public_model_stats_snapshot
    ORDER BY request_count DESC
    LIMIT {{Int32(limit, 50)}}

TYPE endpoint
