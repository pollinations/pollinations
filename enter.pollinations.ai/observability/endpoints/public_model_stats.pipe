DESCRIPTION >
    Public model usage statistics for the last 7 days including today.
    Returns aggregated stats per model including request counts, average costs, and response times.
    Only includes models with at least 3 successful priced requests from at least 2 distinct
    callers, for reliable averages and to keep owner-only models off a public endpoint.

TOKEN tinybird_read_public READ

NODE agent_run_steps
SQL >
    -- What one agent call spent: the model steps and tool calls its run token
    -- paid for, tagged with the request_id of the call that minted it.
    SELECT
        parent_request_id as run_id,
        sum(total_price) as run_price
    FROM generation_event_v2
    WHERE start_time >= now() - INTERVAL 7 DAY
    AND is_final
    AND parent_request_id != ''
    GROUP BY run_id

NODE priced_calls
SQL >
    -- An agent's own row is free, so its price is what its steps cost. Nothing
    -- joins for an ordinary call and run_price is 0, leaving total_price.
    SELECT
        calls.resolved_model_requested as model,
        calls.user_id as user_id,
        calls.total_price + ifNull(steps.run_price, 0) as price,
        calls.response_status as response_status,
        calls.response_time as response_time
    FROM generation_event_v2 as calls
    LEFT JOIN agent_run_steps as steps ON calls.request_id = steps.run_id
    WHERE calls.start_time >= now() - INTERVAL 7 DAY
    AND calls.is_final  -- one row per request; attempts counted separately
    AND calls.resolved_model_requested != 'undefined'

NODE public_model_stats_node
SQL >
    %
    SELECT
        model,
        count() as request_count,
        round(avgIf(price, response_status >= 200 AND response_status < 300 AND price > 0), 6) as avg_cost_usd,
        round(avgIf(response_time, response_status >= 200 AND response_status < 300), 0) as avg_response_ms,
        countIf(response_status >= 200 AND response_status < 300) as success_count,
        countIf(response_status >= 200 AND response_status < 300 AND price > 0) as priced_success_count,
        countIf(response_status >= 400) as error_count
    FROM priced_calls
    GROUP BY model
    -- Two callers, not just three calls: an average over one person is not a
    -- reliable average, and a private community model is owner-only callable
    -- (gen middleware/model.ts), so it can never reach two. That keeps a
    -- model nobody published off a public endpoint without this table having
    -- to carry a visibility column. It does not retract a model that was
    -- public and went private: its earlier callers stay in the 7-day window.
    -- uniqIf, because user_id DEFAULTs to 'undefined' and that sentinel would
    -- otherwise count as the second caller.
    HAVING priced_success_count >= 3
        AND uniqIf(user_id, user_id != 'undefined') >= 2
    ORDER BY request_count DESC
    LIMIT {{Int32(limit, 50)}}

TYPE endpoint
