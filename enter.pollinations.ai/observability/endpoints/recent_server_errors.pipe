TOKEN tinybird_read READ

DESCRIPTION >
Recent actionable server-side failures from the rolling Tinybird error_event datasource.
Defaults to the last 24 hours and returns newest failures first.

NODE recent_server_errors_node
SQL >
    %
    SELECT
        timestamp,
        environment,
        route_path,
        method,
        status,
        duration_ms,
        is_final,
        attempt_index,
        provider,
        model_used,
        gateway_status,
        error_origin,
        gateway_request_id,
        upstream_request_id,
        error_code,
        error_class,
        message,
        stack,
        upstream_host,
        upstream_status,
        upstream_body,
        edge_colo,
        upstream_headers,
        model_requested,
        resolved_model_requested,
        request_inputs,
        user_id,
        user_tier,
        api_key_id
    FROM error_event
    WHERE timestamp >= now() - interval {{Int32(minutes, 1440)}} minute
    AND (is_final OR {{Int32(include_attempts, 0)}} = 1)
    ORDER BY timestamp DESC
    LIMIT {{Int32(limit, 200)}}

TYPE endpoint
