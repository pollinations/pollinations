DESCRIPTION >
    Where traffic comes from and what it turns into, by week. source is the
    campaign utm_source (or ref), else the external referrer hostname, else
    'direct'; these travel on every page view, so a signed-in view still
    carries the source the person arrived from. views counts page views,
    users the distinct signed-in people seen on that source, signups those
    whose account was created around the view, and paid those who completed a
    Stripe checkout within conversion_days of it, so an old customer's new
    visit is not credited as a fresh purchase. No browser identifier is
    involved, so views are views, not distinct visitors. No history before
    tracking was enabled.

TOKEN tinybird_read READ

NODE users
SQL >
    SELECT id AS user_id, fromUnixTimestamp(assumeNotNull(created_at)) AS created_at
    FROM d1_user
    WHERE synced_at = (SELECT max(synced_at) FROM d1_user)
        AND created_at IS NOT NULL

NODE payments
SQL >
    %
    SELECT user_id, groupArray(timestamp) AS paid_at
    FROM stripe_event
    WHERE payment_status = 'paid'
        AND event_type IN ('checkout.session.completed', 'checkout.session.async_payment_succeeded')
        AND user_id != ''
        AND timestamp >= now() - toIntervalDay(least(greatest({{Int32(days, 30)}}, 1), 366))
    GROUP BY user_id

NODE sources
SQL >
    %
    SELECT
        formatDateTime(toStartOfWeek(v.timestamp, 1), '%Y-%m-%d') AS week,
        multiIf(v.utm_source != '', v.utm_source, v.referrer_host != '', v.referrer_host, 'direct') AS source,
        v.utm_medium AS medium,
        v.utm_campaign AS campaign,
        count() AS views,
        uniqIf(v.user_id, v.user_id != '') AS users,
        uniqIf(v.user_id, u.created_at > v.timestamp - toIntervalHour(1)) AS signups,
        uniqIf(
            v.user_id,
            arrayExists(
                paid -> paid >= v.timestamp
                    AND paid <= v.timestamp + toIntervalDay(least(greatest({{Int32(conversion_days, 7)}}, 1), 90)),
                p.paid_at
            )
        ) AS paid
    FROM product_event v
    LEFT JOIN users u ON v.user_id = u.user_id
    LEFT JOIN payments p ON v.user_id = p.user_id
    WHERE v.environment = {{String(environment, 'production')}}
        AND v.event = 'page_viewed'
        AND v.timestamp >= now() - toIntervalDay(least(greatest({{Int32(days, 30)}}, 1), 366))
    GROUP BY week, source, medium, campaign
    ORDER BY week ASC, views DESC

TYPE endpoint
