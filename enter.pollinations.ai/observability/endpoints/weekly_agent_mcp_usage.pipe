DESCRIPTION >
    Agent requests and recorded MCP tool calls, with distinct authenticated users.
    Agent runs exclude internal steps and ordinary community proxies. All outcome
    statuses count, including balance rejections; cache hits are not stored.
    Weeks containing unclassified top-level community traffic return null agent
    metrics, not misleading historical zeros or partial rollout totals.
    MCP covers receipt-emitting tools (Exa, FFmpeg, Computer, Composio), including
    calls inside agents. Pollinations MCP and discovery calls are not recorded.

TOKEN tinybird_read READ

NODE weekly_agent_mcp_usage_node
SQL >
    %
    SELECT
        formatDateTime(toStartOfWeek(start_time, 1), '%Y-%m-%d') AS week,
        if(
            countIf(model_provider_used = 'community' AND community_endpoint_type = '' AND parent_request_id = '') > 0,
            NULL,
            countIf(community_endpoint_type IN ('endpoint_agent', 'code_agent', 'prompt_agent') AND parent_request_id = '' AND event_type != 'mcp.call')
        ) AS agent_requests,
        if(
            countIf(model_provider_used = 'community' AND community_endpoint_type = '' AND parent_request_id = '') > 0,
            NULL,
            uniqIf(user_id, community_endpoint_type IN ('endpoint_agent', 'code_agent', 'prompt_agent') AND parent_request_id = '' AND event_type != 'mcp.call' AND user_id NOT IN ('', 'undefined'))
        ) AS agent_users,
        countIf(event_type = 'mcp.call') AS mcp_calls,
        uniqIf(user_id, event_type = 'mcp.call' AND user_id NOT IN ('', 'undefined')) AS mcp_users
    FROM generation_event_v2
    WHERE
        {% if defined(start_date) %}
        start_time >= toDate({{ String(start_date) }})
        AND start_time < toDate({{ String(start_date) }}) + INTERVAL 7 DAY
        {% else %}
        start_time >= now() - INTERVAL {{Int32(weeks_back, 12)}} WEEK
        {% end %}
        AND is_final
    GROUP BY week
    ORDER BY week ASC

TYPE endpoint
