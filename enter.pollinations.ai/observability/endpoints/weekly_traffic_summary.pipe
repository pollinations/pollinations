DESCRIPTION >
    Separate legacy volumes and all-traffic modelled cost for KPI cash coverage.
    Customer adoption and usage remain in the regular-only weekly endpoints.

TOKEN tinybird_read READ

NODE weekly_traffic_summary_node
SQL >
    %
    SELECT
        formatDateTime(toStartOfWeek(start_time, 1), '%Y-%m-%d') AS week,
        countIf(traffic_group = 'legacy') AS legacy_requests,
        countIf(traffic_group = 'legacy' AND response_status >= 200 AND response_status < 300) AS legacy_successful_requests,
        sum(if(model_provider_used = 'community', community_model_reward_amount, total_cost)) AS all_traffic_cost_usd
    FROM generation_events_classified
    WHERE
        {% if defined(start_date) %}
        start_time >= toDate({{String(start_date)}})
        AND start_time < toDate({{String(start_date)}}) + INTERVAL 7 DAY
        {% else %}
        start_time >= now() - INTERVAL {{Int32(weeks_back, 12)}} WEEK
        {% end %}
        AND is_final
    GROUP BY week
    ORDER BY week

TYPE endpoint
