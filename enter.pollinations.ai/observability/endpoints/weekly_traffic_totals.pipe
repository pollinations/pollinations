DESCRIPTION >
    Weekly requests and compute cost across every traffic group, with the
    legacy part split out. KPI reads it for cash coverage (Stripe cash is
    company-wide, so its cost side must be too) and the legacy migration row.
    Supports start_date param for single-week queries to avoid Tinybird timeouts.

TOKEN tinybird_read READ

NODE weekly_traffic_totals_node
SQL >
    %
    WITH
        -- Same cost rule as weekly_usage_stats: community total_cost is its
        -- sale price, and the owner reward is the corresponding cost.
        if(
            model_provider_used = 'community',
            community_model_reward_amount,
            total_cost
        ) AS request_cost
    SELECT
        formatDateTime(toStartOfWeek(start_time, 1), '%Y-%m-%d') AS week,
        count() AS total_requests,
        countIf(traffic_group = 'legacy') AS legacy_requests,
        sum(request_cost) AS total_cost_usd,
        sumIf(request_cost, traffic_group = 'legacy') AS legacy_cost_usd
    FROM generation_events_classified
    WHERE
        {% if defined(start_date) %}
        start_time >= toDate({{ String(start_date) }})
        AND start_time < toDate({{ String(start_date) }}) + INTERVAL 7 DAY
        {% else %}
        start_time >= now() - INTERVAL {{Int32(weeks_back, 12)}} WEEK
        {% end %}
        AND is_final  -- one row per request; attempts counted separately
    GROUP BY week
    ORDER BY week ASC

TYPE endpoint
