DESCRIPTION >
    Weekly BYOP vs non-BYOP usage metrics.
    BYOP = authorize-flow metadata (api_key_created_via = 'redirect-auth')
    OR legacy hostname heuristic (secret key with dot in name).
    Two-node design: inner node evaluates the condition once per row,
    outer node pivots back to the original column schema.

TOKEN tinybird_read READ

NODE grouped_by_byop
SQL >
    %
    SELECT
        formatDateTime(toStartOfWeek(start_time, 1), '%Y-%m-%d') AS week,
        ((api_key_type = 'secret' AND position(api_key_name, '.') > 0) OR api_key_created_via = 'redirect-auth') AS is_byop,
        uniq(user_id) AS users,
        sum(total_price) AS pollen,
        count() AS requests,
        -- 402 = out of Pollen, rejected before a provider ran. See
        -- weekly_active_users.
        uniq(if(response_status != 402, user_id, null)) AS served_users,
        countIf(response_status != 402) AS served_requests
    FROM generation_event_v2
    WHERE
        -- One row per request: a fallback attempt is part of a request, not
        -- another one, and it carries no user, price or tokens of its own.
        is_final
        AND
        {% if defined(start_date) %}
        start_time >= toDate({{ String(start_date) }})
        AND start_time < toDate({{ String(start_date) }}) + INTERVAL 7 DAY
        {% else %}
        start_time >= now() - INTERVAL {{ Int32(weeks_back, 12) }} WEEK
        {% end %}
    GROUP BY week, is_byop

NODE weekly_user_segment_node
SQL >
    SELECT
        week,
        sumIf(users, is_byop = 1) AS byop_users,
        sumIf(pollen, is_byop = 1) AS byop_pollen,
        sumIf(requests, is_byop = 1) AS byop_requests,
        sumIf(served_users, is_byop = 1) AS byop_served_users,
        sumIf(users, is_byop = 0) AS other_users,
        sumIf(served_users, is_byop = 0) AS other_served_users,
        sumIf(pollen, is_byop = 0) AS other_pollen,
        sumIf(requests, is_byop = 0) AS other_requests,
        byop_users + other_users AS total_users,
        byop_pollen + other_pollen AS total_pollen,
        byop_requests + other_requests AS total_requests,
        byop_served_users + other_served_users AS total_served_users,
        if(total_users > 0, round(byop_users / total_users * 100, 1), 0) AS byop_user_pct,
        if(total_served_users > 0, round(byop_served_users / total_served_users * 100, 1), 0) AS byop_served_user_pct,
        if(total_pollen > 0, round(byop_pollen / total_pollen * 100, 1), 0) AS byop_pollen_pct
    FROM grouped_by_byop
    GROUP BY week
    ORDER BY week ASC

TYPE endpoint
