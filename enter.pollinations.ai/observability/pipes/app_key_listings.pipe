DESCRIPTION >
    Credits each registered App Key to the one catalog listing of the same
    owner whose URL covers the key's redirect URI. Without a URL match, the key
    is credited to the owner's listing only when the owner has exactly one.
    Ambiguous keys are excluded. Shared by the weekly app ranking and the
    catalog's BYOP metrics.

NODE latest_users
SQL >
    SELECT id AS user_id, toString(github_id) AS github_user_id
    FROM d1_user
    WHERE synced_at = (SELECT max(synced_at) FROM d1_user) AND banned = 0

NODE registered_apps
SQL >
    SELECT
        id AS app_key_id,
        user_id AS owner_user_id,
        arrayJoin(
            JSONExtract(coalesce(metadata, '{}'), 'redirectUris', 'Array(String)')
        ) AS redirect_uri
    FROM d1_apikey
    WHERE
        synced_at = (SELECT max(synced_at) FROM d1_apikey)
        AND prefix = 'pk'
        AND JSONExtractString(metadata, 'keyType') = 'publishable'

NODE catalog_apps
SQL >
    SELECT
        name, web_url, github_user_id, github_username, replaceRegexpOne(web_url, '/+$', '') AS base_url
    FROM app_directory
    WHERE
        github_user_id != ''
        AND name != ''
        AND (startsWith(web_url, 'https://') OR startsWith(web_url, 'http://'))

NODE matched_apps
SQL >
    SELECT
        registered.app_key_id,
        uniqExactIf(
            tuple(catalog.web_url, catalog.name),
            registered.redirect_uri = catalog.base_url
            OR startsWith(registered.redirect_uri, concat(catalog.base_url, '/'))
            OR startsWith(registered.redirect_uri, concat(catalog.base_url, '?'))
            OR startsWith(registered.redirect_uri, concat(catalog.base_url, '#')) AS url_match
        ) AS url_matches,
        uniqExact(tuple(catalog.web_url, catalog.name)) AS owner_listings,
        if(url_matches = 1, anyIf(catalog.web_url, url_match), any(catalog.web_url)) AS app_url,
        if(url_matches = 1, anyIf(catalog.name, url_match), any(catalog.name)) AS app_name,
        any(catalog.github_username) AS owner,
        any(catalog.github_user_id) AS github_user_id
    FROM registered_apps registered
    INNER JOIN latest_users users ON registered.owner_user_id = users.user_id
    INNER JOIN catalog_apps catalog ON users.github_user_id = catalog.github_user_id
    GROUP BY registered.app_key_id
    HAVING url_matches = 1 OR owner_listings = 1
