{
    "extends": "../../enter.pollinations.ai/frontend/src/tsconfig.json",
    "include": [
        "pollen-connect-*.ts",
        "pollen-connect-*.tsx",
        "live-*.ts",
        "live-*.tsx",
        "enter-entry.ts",
        "dev.ts",
        "reset.ts",
        "runtime.ts",
        "fixtures.ts",
        "server.ts",
        "../../enter.pollinations.ai/worker-runtime.d.ts",
        "../../enter.pollinations.ai/worker-bindings.d.ts",
        "../../enter.pollinations.ai/frontend/src/**/*.ts",
        "../../enter.pollinations.ai/frontend/src/**/*.tsx"
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@frontend/*": ["../../enter.pollinations.ai/frontend/src/*"],
            "@shared/*": ["../../shared/*"],
            "@pollinations/sdk": ["../../packages/sdk/src/index.ts"],
            "@pollinations/sdk/react": ["../../packages/sdk/src/react/index.ts"],
            "@pollinations/ui": ["../../packages/ui/src/index.ts"],
            "@pollinations/ui/auth": ["../../packages/ui/src/modules/auth/index.ts"],
            "@pollinations/ui/auth/sdk": ["../../packages/ui/src/modules/auth/sdk.ts"],
            "@pollinations/ui/app-user-menu/sdk": ["../../packages/ui/src/modules/app-user-menu/sdk.ts"],
            "@pollinations/ui/gen": ["../../packages/ui/src/modules/gen/index.ts"],
            "@pollinations/ui/wallet": ["../../packages/ui/src/modules/wallet/index.ts"]
        },
        "noUnusedLocals": true,
        "noUnusedParameters": true
    }
}
