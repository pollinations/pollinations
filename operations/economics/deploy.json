{
  "target": "script",
  "credentials": "myceli",
  "sops": "economics",
  "install": "npm ci --prefix ../..",
  "build": "npm run build --prefix web",
  "deploy": "sops exec-file --no-fifo secrets/web.json 'node web/scripts/check-tinybird-contract.mjs --secrets-file {} && cd web && npx wrangler deploy --secrets-file {}'",
