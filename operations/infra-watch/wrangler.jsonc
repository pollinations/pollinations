{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "infra-watch",
    "account_id": "b6ec751c0862027ba269faf7029b2501",
    "main": "src/index.js",
    "workers_dev": true,
    "compatibility_date": "2026-08-26",
    "observability": { "enabled": true },
    "triggers": { "crons": ["* * * * *"] },
    "durable_objects": {
        "bindings": [{ "name": "WATCH", "class_name": "Watch" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Watch"] }]
}
