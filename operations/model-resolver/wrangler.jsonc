{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "pollinations-model-management",
    "main": "worker.mjs",
    "compatibility_date": "2026-10-06",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "preview_urls": false,
    "r2_buckets": [
        { "binding": "RESEARCH_EVIDENCE", "bucket_name": "pollinations-model-management-evidence" }
    ],
    "triggers": {
        "crons": ["*/10 * * * *"]
    },
    "durable_objects": {
        "bindings": [
            { "name": "MODEL_TASKS", "class_name": "ModelManagementTask" }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ModelManagementTask"] }
    ],
    "vars": {
        "ENABLED": "false",
        "REPOSITORY": "pollinations/pollinations",
        "ACCOUNT_GITHUB_USERNAME": "pollinations-ai",
        "DISCOVERY_MODEL": "community/pollinations-ai/model-manager-agent",
        "PRICING_MODEL": "community/pollinations-ai/model-pricing-researcher",
        "STEWARD_MODEL": "community/pollinations-ai/model-resolver-agent",
        "POLLI_MODEL": "community/pollinations-ai/polli",
        "POLLI_BASE_MODEL": "openai/gpt-6-sol",
        "TASK_BUDGET": "1",
        "RESEARCH_BUDGET": "0.2",
        "MAX_TASK_TURNS": "40",
        "LEASE_MS": "600000"
    }
}
