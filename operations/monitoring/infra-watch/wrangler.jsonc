{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "infra-watch",
    "account_id": "b6ec751c0862027ba269faf7029b2501",
    "main": "src/index.js",
    "workers_dev": true,
    "compatibility_date": "2026-08-26",
    "observability": { "enabled": true },
    "triggers": { "crons": ["* * * * *"] },
    // Domain detection inputs, shared with Enter. D1 owns each account's
    // Quest Pollen spending restriction.
    "kv_namespaces": [
        { "binding": "SETUP_HOLDS", "id": "957b3d13dc2c4142ab22fdf889f27bec" }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "production-pollinations-enter-db",
            "database_id": "fc771b05-4e24-48bf-980c-d09f21279bd1"
        }
    ],
    "durable_objects": {
        "bindings": [{ "name": "WATCH", "class_name": "Watch" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Watch"] }]
}
