      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PAD1A0A25CD30D456"
          },
          "format": 1,
          "range": true,
          "rawSql": "SELECT\n  toStartOfDay(hour) AS time,\n  multiIf(\n    is_byop = 1 AND is_community = 1, 'BYOP · BYOM',\n    is_byop = 1, 'BYOP · Pollinations models',\n    is_community = 1, 'BYOM · Direct',\n    'Direct API'\n  ) AS product_path,\n  sumMerge(successful_calls) AS requests,\n  round(sumMergeIf(gross_consumption, funding_source = 'paid'), 2) AS paid_pollen,\n  round(sumMergeIf(gross_consumption, funding_source = 'quest'), 2) AS quest_pollen\nFROM generation_usage_hourly\nWHERE $__timeFilter(hour)\n  AND environment IN ('production', 'debug-prod-copy')\nGROUP BY time, product_path\nORDER BY time, product_path",
          "refId": "A"
        }
      ],
      "title": "Paid Pollen consumption by product path",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "product_path"
            ]
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "/^(time.*|paid_pollen.*)$/"
            }
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "paid_pollen (.*)",
            "renamePattern": "$1"
          }
        }
      ],
      "type": "timeseries"
    },
