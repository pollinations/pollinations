      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "PAD1A0A25CD30D456"
          },
          "format": 0,
          "range": true,
          "rawSql": "SELECT\n  toStartOfDay(hour) AS time,\n  sumMergeIf(gross_consumption, funding_source = 'paid' AND is_community = 0) AS paid_pollinations,\n  sumMergeIf(gross_consumption, funding_source = 'paid' AND is_community = 1) AS paid_community,\n  sumMergeIf(gross_consumption, funding_source = 'quest' AND is_community = 0) AS quest_pollinations,\n  sumMergeIf(gross_consumption, funding_source = 'quest' AND is_community = 1) AS quest_community\nFROM generation_usage_hourly\nWHERE $__timeFilter(hour)\n  AND environment IN ('production', 'debug-prod-copy')\n  AND traffic_group = 'regular'\n  AND funding_source IN ('paid', 'quest')\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Quest vs Paid spending",
      "type": "timeseries"
