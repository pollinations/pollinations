{
  "pr_number": 17354,
  "title": "fix: price direct-Vertex Gemini at cost",
  "author": "ElliotEtag",
  "url": "https://github.com/pollinations/pollinations/pull/17354",
  "merged_at": "2026-10-13T20:20:00Z",
  "labels": [],
  "gist": {
    "category": "bug_fix",
    "user_facing": true,
    "publish_tier": "none",
    "importance": "minor",
    "summary": "Removed the former OpenRouter fee from direct-Vertex pricing for Gemini 3 Flash Preview, Gemini 3.7 Flash, Gemini 3.8 Flash, Gemini 3.5 Flash Lite, Gemini 3.1 Pro Preview, Nano Banana, Nano Banana 2, Nano Banana 2 Lite and Nano Banana Pro. Their input and output token rates, along with applicable search rates per 1,000 queries and cache-storage rates per 1 million tokens written for one hour, decrease by about 5.2% to match Google's list cost. Gemini 3.1 Pro Preview's long-context rates also decrease. OpenRouter fallback requests still cost 5.5% more than users are charged at the revised rates. Local Vertex tests confirmed that wallet debits matched provider cost for Gemini 3.5 Flash Lite and Nano Banana 2 Lite.",
    "keywords": [
      "Gemini",
      "Vertex",
      "Nano Banana",
      "pricing",
      "Pollen",
      "fallback"
    ]
  },
