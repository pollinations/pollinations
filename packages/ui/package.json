{
    "name": "@pollinations/ui",
    "version": "0.1.0-alpha.21",
    "description": "Design primitives and UI modules for Pollinations apps.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "unpkg": "./dist/index.browser.min.js",
    "jsdelivr": "./dist/index.browser.min.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./umd": "./dist/index.browser.min.js",
        "./auth": {
            "types": "./dist/auth/index.d.ts",
            "default": "./dist/auth/index.js"
        },
        "./auth/sdk": {
            "types": "./dist/auth/sdk.d.ts",
            "default": "./dist/auth/sdk.js"
        },
        "./app-user-menu/sdk": {
            "types": "./dist/app-user-menu/sdk.d.ts",
            "default": "./dist/app-user-menu/sdk.js"
        },
        "./gen": {
            "types": "./dist/gen/index.d.ts",
            "default": "./dist/gen/index.js"
        },
        "./markdown": {
            "types": "./dist/markdown.d.ts",
            "default": "./dist/markdown.js"
        },
        "./wallet": {
            "types": "./dist/wallet/index.d.ts",
            "default": "./dist/wallet/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./app.css": "./dist/app.css",
        "./brand/*": "./dist/brand/*",
        "./fonts/*": "./dist/fonts/*",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "npm run build:palette && npm run build:js && npm run build:css && npm run build:fonts && npm run build:brand && npm run build:licenses",
        "build:palette": "node scripts/gen-theme-palette.mjs",
        "build:fonts": "mkdir -p dist/fonts && cp src/fonts/*.woff2 dist/fonts/",
        "build:brand": "mkdir -p dist/brand && cp -R src/brand/. dist/brand/",
        "build:licenses": "mkdir -p dist/licenses && cp src/licenses/*.txt dist/licenses/",
        "build:js": "tsup",
        "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify && cp src/styles/theme.css dist/theme.css && sed 's|@pollinations/ui/styles.css|./styles.css|' src/styles/app.css > dist/app.css",
        "brand": "node scripts/brand/generate.mjs",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:package": "npm run build:js && node --test scripts/package-exports.test.mjs",
        "test:watch": "vitest"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pollinations/pollinations.git",
        "directory": "packages/ui"
    },
    "peerDependencies": {
        "@pollinations/sdk": "^5.1.0-alpha.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "peerDependenciesMeta": {
        "@pollinations/sdk": {
            "optional": true
        }
    },
    "dependencies": {
        "@ark-ui/react": "^5.29.1",
        "clsx": "^2.1.1",
        "react-markdown": "^10.1.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@pollinations/sdk": "*",
        "@tailwindcss/cli": "^4.0.0",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/react-test-renderer": "^19.1.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-test-renderer": "^19.2.5",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.0.0",
        "tsup": "^8.3.5",
        "typescript": "^5.6.3",
        "vitest": "^4.1.12"
    }
}
