+++ b/tests/integrations/test_prime_harness.py
@@ -0,0 +1,217 @@
+"""End-to-end tests for `polli harness prime`.
+
+These tests exercise the installer against a throwaway Prime home so
+we can verify the full lifecycle (install -> status -> reinstall ->
+off) and the preservation of unrelated state.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from polli.integrations.prime import install, uninstall, status
+from polli.integrations.prime.provider import (
+    PRIME_PROVIDER_ID, SUPPORTED_MODELS, default_model_id,
+)
+
+
+@pytest.fixture
+def prime_home(tmp_path, monkeypatch):
+    """A minimal fake Prime installation."""
+    home = tmp_path / "prime"
+    home.mkdir()
+    (home / "config.json").write_text("{}")
+    (home / "providers.json").write_text(json.dumps({"providers": [
+        {"id": "openai", "kind": "openai-compatible"}
+    ]}))
+    (home / "skills").mkdir()
+    (home / "skills" / "user_skill.md").write_text("# keep me\n")
+    (home / "memories.json").write_text("{}")
+    (home / "sessions").mkdir()
+    (home / "sessions" / "s1.json").write_text("{}")
+    monkeypatch.setenv("PRIME_HOME", str(home))
+    return home
+
+
+def _key() -> str:
+    return "polli_testkey_primeagent_abc123"
+
+
+# ---------------------------------------------------------------------------
# Discovery
+ ---------------------------------------------------------------------------
+
+def test_status_when_prime_missing(tmp_path, monkeypatch):
+    monkeypatch.setenv("PRIME_HOME", str(tmp_path / "nope"))
+    s = status()
+    assert not s.installed
+    assert s.prime_home is None
+    assert "not found" in (s.note or "").lower()
+
+
+# ---------------------------------------------------------------------------
# Install / status
+ ---------------------------------------------------------------------------
+
+def test_install_registers_provider_and_skill(prime_home):
+    s = install(api_key=_key())
+    assert s.installed
+    assert s.provider_registered
+    assert s.skill_installed
+    assert s.default_model == default_model_id()
+    assert set(s.available_models) == {m.id for m in SUPPORTED_MODELS}
+
+    providers = json.loads((prime_home / "providers.json").read_text())
+    ids = [p["id"] for p in providers["providers"]]
+    assert PRIME_PROVIDER_ID in ids
+    # Unrelated provider preserved
+    assert "openai" in ids
+
+    assert (prime_home / "skills" / "polli.md").exists()
+    # Unrelated skill preserved
+    assert (prime_home / "skills" / "user_skill.md").exists()
+
+
+def test_install_is_idempotent(prime_home):
+    install(api_key=_key())
+    s1 = status()
+    install(api_key=_key())  # second install
+    s2 = status()
+    assert s1 == s2
+    # No duplicate provider entries
+    providers = json.loads((prime_home / "providers.json").read_text())
+    pollis = [p for p in providers["providers"]
+              if p["id"] == PRIME_PROVIDER_ID]
+    assert len(pollis) == 1
+
+
+def test_install_replaces_stale_provider_entry(prime_home):
+    install(api_key="polli_OLD")
+    install(api_key="polli_NEW")
+    providers = json.loads((prime_home / "providers.json").read_text())
+    entry = next(p for p in providers["providers"]
+                 if p["id"] == PRIME_PROVIDER_ID)
+    assert entry["auth"]["value"] == "polli_NEW"
+
+
+def test_install_with_custom_default_model(prime_home):
+    s = install(api_key=_key(), default_model="mistral")
+    assert s.default_model == "mistral"
+
+
+def test_install_falls_back_on_unknown_default_model(prime_home):
+    s = install(api_key=_key(), default_model="nonexistent")
+    assert s.default_model == default_model_id()
+
+
+# ---------------------------------------------------------------------------
# Preservation of unrelated state
+ ---------------------------------------------------------------------------
+
+def test_install_preserves_sessions_and_memories(prime_home):
+    install(api_key=_key())
+    assert (prime_home / "memories.json").read_text() == "{}"
+    assert (prime_home / "sessions" / "s1.json").exists()
+    assert (prime_home / "skills" / "user_skill.md").read_text() == "# keep me\n"
+
+
+def test_install_writes_backup(prime_home):
+    install(api_key=_key())
+    backups = list((prime_home / ".backups").iterdir())
+    assert backups, "expected a backup snapshot"
+    # Backup must contain the pre-install providers.json
+    assert any((b / "providers.json").exists() for b in backups)
+
+
+# ---------------------------------------------------------------------------
# Uninstall
+ ---------------------------------------------------------------------------
+
+def test_uninstall_removes_only_polli_artifacts(prime_home):
+    install(api_key=_key())
+    s = uninstall(revoke_key=False)
+    assert not s.installed
+    assert not s.provider_registered
+    assert not s.skill_installed
+
+    providers = json.loads((prime_home / "providers.json").read_text())
+    ids = [p["id"] for p in providers["providers"]]
+    assert PRIME_PROVIDER_ID not in ids
+    assert "openai" in ids  # unrelated provider preserved
+
+    assert not (prime_home / "skills" / "polli.md").exists()
+    assert (prime_home / "skills" / "user_skill.md").exists()  # untouched
+
+
+def test_uninstall_when_not_installed_is_noop(prime_home):
+    s = uninstall(revoke_key=False)
+    assert not s.installed
+    # Unrelated provider still there
+    providers = json.loads((prime_home / "providers.json").read_text())
+    assert "openai" in [p["id"] for p in providers["providers"]]
+
+
+# ---------------------------------------------------------------------------
# Corrupt registry handling
+ ---------------------------------------------------------------------------
+
+def test_install_recovers_from_corrupt_providers_json(prime_home):
+    (prime_home / "providers.json").write_text("{not json")
+    s = install(api_key=_key())
+    assert s.installed
+    # Corrupt file was moved aside, not overwritten in place
+    assert (prime_home / "providers.json.corrupt").exists()