+"""Pollinations custom-provider descriptor for Prime Agent.
+
+Prime supports user-defined providers via a JSON registry at
+`$PRIME_HOME/providers.json`. Each entry is a small descriptor with a
+base URL, an auth header, and a model catalogue. This module returns
+the descriptor Pollinations uses; the installer writes it into the
+registry without touching other entries.
+"""
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+from typing import Optional
+
+# Public endpoint Prime will call. Pollinations exposes an
+# OpenAI-compatible surface, so Prime treats it as an
+# "openai-compatible" provider.
+POLLINATIONS_BASE_URL = "https://text.pollinations.ai/openai"
+
+# Identifier used in Prime's providers.json. Stable across reinstalls
+# so the installer can replace prior entries idempotently.
+PRIME_PROVIDER_ID = "pollinations"
+
+# Scope tagged on the API key issued by `polli login` for Prime. Kept
+# distinct from other Pollinations scopes so it can be rotated or
+# revoked without affecting unrelated clients.
+PRIME_KEY_SCOPE = "prime-agent"
+
+
+@dataclass(frozen=True)
+class Model:
+    """A Pollinations model exposed to Prime."""
+    id: str
+    label: str
+    context_window: int
+    default: bool = False
+
+
+# The set of Pollinations models currently known to be compatible with
+# Prime's OpenAI-compatible client. Exactly one is marked `default`.
+# Adding a model here is the only change required to expose new ones.
+SUPPORTED_MODELS: tuple[Model, ...] = (
+    Model("openai",   "Pollinations OpenAI (gpt-class)", 128_000, default=True),
+    Model("mistral",  "Pollinations Mistral",             64_000),
+    Model("llama",    "Pollinations Llama",               32_000),
+)
+
+
+def default_model_id() -> str:
+    """Return the id of the default Pollinations model for Prime."""
+    return next(m.id for m in SUPPORTED_MODELS if m.default)
+
+
+def model_choices() -> list[str]:
+    """Return all currently supported model ids (for CLI choices)."""
+    return [m.id for m in SUPPORTED_MODELS]
+
+
+def provider_descriptor(api_key: str, default_model: Optional[str] = None) -> dict:
+    """Build the JSON descriptor Prime expects for a custom provider.
+
+    The descriptor is self-contained: Prime never has to reach into
+    Polli's config to know how to call Pollinations.
+    """
+    chosen = default_model or default_model_id()
+    # Sanity-check the chosen default; fall back if a stale choice
+    # is passed (e.g. after a model has been removed from the list).
+    if chosen not in {m.id for m in SUPPORTED_MODELS}:
+        chosen = default_model_id()
+    return {
+        "id": PRIME_PROVIDER_ID,
+        "kind": "openai-compatible",
+        "base_url": POLLINATIONS_BASE_URL,
+        "auth": {
+            "header": "Authorization",
+            "scheme": "Bearer",
+            "value": api_key,
+        },
+        "models": [asdict(m) for m in SUPPORTED_MODELS],
+        "default_model": chosen,
+        "labels": {
+            "vendor": "Pollinations",
+            "managed_by": "polli",
+        },
+    }
diff --git a/polli/integrations/prime/installer.py b/polli/integrations/prime/installer.py
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/polli/integrations/prime/installer.py
@@ -0,0 +1,263 @@
+"""Install / uninstall / inspect the Pollinations <-> Prime integration.
+
+Design notes
+------------
+* Idempotent: running `on` twice yields the same on-disk state.
+* Non-destructive: Prime's existing providers, skills, sessions,
+  memories, and unrelated config are preserved. A timestamped backup
+  is written under `$PRIME_HOME/.backups/` before any modification.
+* Reversible: `off` removes only the Pollinations provider and skill
+  and (optionally) rotates the dedicated API key. No Prime state is
+  deleted.
+* Detects a missing Prime installation and reports it instead of
+  silently creating directories the user did not ask for.
+"""
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Optional
+
+from ..keys import (
+    ensure_scoped_key,
+    revoke_scoped_key,
+)
+from .provider import (
+    PRIME_KEY_SCOPE,
+    PRIME_PROVIDER_ID,
+    SUPPORTED_MODELS,
+    default_model_id,
+    provider_descriptor,
+)
+
+PRIME_HOME_ENV = "PRIME_HOME"
+DEFAULT_PRIME_HOME = Path.home() / ".prime"
+
+PROVIDERS_FILE = "providers.json"
+SKILLS_DIR = "skills"
+CONFIG_FILE = "config.json"
+
+SKILL_NAME = "polli"
+POLLI_MARKER_KEY = "_polli_managed"  # tags entries we own in providers.json
+
+
+# ---------------------------------------------------------------------------
+# Prime home discovery
+# ---------------------------------------------------------------------------
+
+@dataclass
+class PrimeHome:
+    """A handle to a Prime Agent installation on disk."""
+
+    root: Path
+
+    @classmethod
+    def discover(cls) -> Optional["PrimeHome"]:
+        """Locate the Prime installation, or return None if absent.
+
+        We deliberately *do not* create the directory: if Prime isn't
+        installed, the caller should surface the official install path
+        rather than silently materialising state Prime doesn't expect.
+        """
+        root = Path(os.environ.get(PRIME_HOME_ENV, DEFAULT_PRIME_HOME))
+        if (root / CONFIG_FILE).exists():
+            return cls(root)
+        return None
+
+    @property
+    def exists(self) -> bool:
+        return (self.root / CONFIG_FILE).exists()
+
+    @property
+    def providers_path(self) -> Path:
+        return self.root / PROVIDERS_FILE
+
+    @property
+    def skills_dir(self) -> Path:
+        return self.root / SKILLS_DIR
+
+    # --- non-destructive backup ----------------------------------------
+    def snapshot(self) -> Path:
+        """Copy current providers/skills into a timestamped backup dir.
+
+        Always called before any write. Lets us recover from a botched
+        run without relying on the user having their own backups.
+        """
+        if not self.exists:
+            raise FileNotFoundError(f"Prime home not found at {self.root}")
+        dst = self.root / ".backups" / f"polli-{int(time.time())}"
+        dst.mkdir(parents=True, exist_ok=True)
+        if self.providers_path.exists():
+            shutil.copy2(self.providers_path, dst / PROVIDERS_FILE)
+        if self.skills_dir.exists():
+            shutil.copytree(
+                self.skills_dir, dst / SKILLS_DIR, dirs_exist_ok=True
+            )
+        return dst
+
+
+# ---------------------------------------------------------------------------
+# Integration state (returned to the CLI)
+# ---------------------------------------------------------------------------
+
+@dataclass
+class IntegrationState:
+    installed: bool
+    provider_registered: bool
+    skill_installed: bool
+    default_model: Optional[str]
+    available_models: list[str] = field(default_factory=list)
+    prime_home: Optional[str] = None
+    note: Optional[str] = None
+
+
+# ---------------------------------------------------------------------------
+# JSON helpers
+# ---------------------------------------------------------------------------
+
+def _load_providers(home: PrimeHome) -> dict:
+    if not home.providers_path.exists():
+        return {"providers": []}
+    try:
+        return json.loads(home.providers_path.read_text() or '{"providers": []}')
+    except json.JSONDecodeError:
+        # Don't destroy a corrupt file; back it up and start fresh.
+        corrupt = home.providers_path.with_suffix(".json.corrupt")
+        home.providers_path.replace(corrupt)
+        return {"providers": []}
+
+
+def _save_providers(home: PrimeHome, data: dict) -> None:
+    """Atomic write so a crash mid-write can't corrupt the registry."""
+    home.providers_path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = home.providers_path.with_suffix(".json.tmp")
+    tmp.write_text(json.dumps(data, indent=2))
+    tmp.replace(home.providers_path)
+
+
+def _load_skill_template() -> str:
+    here = Path(__file__).parent
+    return (here / "skill_template.md").read_text()
+
+
+# ---------------------------------------------------------------------------
+# Public operations
+# ---------------------------------------------------------------------------
+
+def install(
+    *,
+    api_key: str,
+    default_model: Optional[str] = None,
+    refresh_skill: bool = True,
+) -> IntegrationState:
+    """Idempotently install the Pollinations provider + skill into Prime.
+
+    `api_key` is the scoped key issued by `polli login --scope prime-agent`.
+    Pass `refresh_skill=False` to leave an existing `polli` skill alone
+    (e.g. if the user has customised it).
+    """
+    home = PrimeHome.discover()
+    if home is None:
+        return IntegrationState(
+            installed=False,
+            provider_registered=False,
+            skill_installed=False,
+            default_model=None,
+            available_models=[m.id for m in SUPPORTED_MODELS],
+            note="Prime Agent not found; offer the official install.",
+        )
+
+    home.snapshot()  # always take a non-destructive backup first
+
+    descriptor = provider_descriptor(api_key, default_model=default_model)
+    descriptor[POLLI_MARKER_KEY] = True
+
+    data = _load_providers(home)
+    providers = data.setdefault("providers", [])
+    # Replace any prior Pollinations entry; keep everything else as-is.
+    providers = [p for p in providers if p.get("id") != PRIME_PROVIDER_ID]
+    providers.append(descriptor)
+    data["providers"] = providers
+    _save_providers(home, data)
+
+    # Install / refresh skill. We only own `polli.md`; we never touch
+    # other files in skills/.
+    skill_path = home.skills_dir / f"{SKILL_NAME}.md"
+    home.skills_dir.mkdir(parents=True, exist_ok=True)
+    if refresh_skill or not skill_path.exists():
+        skill_path.write_text(_load_skill_template())
+
+    return status()
+
+
+def uninstall(*, revoke_key: bool = True) -> IntegrationState:
+    """Disconnect Pollinations from Prime without removing Prime state.
+
+    Removes the `pollinations` entry from providers.json and the
+    `polli.md` skill. Other providers, skills, sessions, and memories
+    are untouched. If `revoke_key` is True, also rotates the scoped
+    key issued for Prime so a leaked copy in a backup can't be reused.
+    """
+    home = PrimeHome.discover()
+    if home is None:
+        return IntegrationState(
+            installed=False,
+            provider_registered=False,
+            skill_installed=False,
+            default_model=None,
+            available_models=[],
+            note="Prime Agent not found; nothing to disconnect.",
+        )
+    home.snapshot()
+
+    data = _load_providers(home)
+    data["providers"] = [
+        p for p in data.get("providers", [])
+        if p.get("id") != PRIME_PROVIDER_ID
+    ]
+    _save_providers(home, data)
+
+    skill = home.skills_dir / f"{SKILL_NAME}.md"
+    if skill.exists():
+        skill.unlink()
+
+    if revoke_key:
+        revoke_scoped_key(scope=PRIME_KEY_SCOPE)
+
+    return status()
+
+
+def status() -> IntegrationState:
+    """Report whether the integration is ready for use.
+
+    `installed` is True only when *both* the provider and the skill
+    are present; that's the contract `polli harness prime status`
+    exposes to users.
+    """
+    home = PrimeHome.discover()
+    if home is None:
+        return IntegrationState(
+            installed=False,
+            provider_registered=False,
+            skill_installed=False,
+            default_model=None,
+            available_models=[m.id for m in SUPPORTED_MODELS],
+            note="Prime Agent not found.",
+        )
+
+    data = _load_providers(home)
+    provider = next(
+        (p for p in data.get("providers", [])
+         if p.get("id") == PRIME_PROVIDER_ID),
+        None,
+    )
+    skill_installed = (home.skills_dir / f"{SKILL_NAME}.md").exists()
+    return IntegrationState(
+        installed=bool(provider) and skill_installed,
+        provider_registered=bool(provider),
+        skill_installed=skill_installed,
+        default_model=provider.get("default_model") if provider else None,
+        available_models=[m.id for m in SUPPORTED_MODELS],
+        prime_home=str(home.root),
+    )
