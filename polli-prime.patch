@@ -0,0 +1,152 @@
+"""`polli harness prime` subcommands: on | off | status."""
+from __future__ import annotations
+
+import argparse
+import sys
+from typing import Optional
+
+from ...integrations.prime import install, uninstall, status as status_fn
+from ...integrations.prime.provider import (
+    PRIME_KEY_SCOPE,
+    SUPPORTED_MODELS,
+    default_model_id,
+    model_choices,
+)
+from ...keys import ensure_scoped_key
+
+# Official Prime Agent install location, surfaced when Prime isn't
+# detected. Kept as a constant so docs and CLI agree.
+PRIME_INSTALL_URL = "https://github.com/PrimeAgent/prime"
+
+
+def _format_state(state) -> None:
+    print("Pollinations <-> Prime integration")
+    print(f"  installed        : {'yes' if state.installed else 'no'}")
+    print(
+        "  provider         : "
+        + ("registered" if state.provider_registered else "absent")
+    )
+    print(
+        "  skill            : "
+        + ("present" if state.skill_installed else "absent")
+    )
+    print(f"  default model    : {state.default_model or '(none)'}")
+    print(
+        "  available models : "
+        + (", ".join(state.available_models) if state.available_models
+           else "(none)")
+    )
+    if state.prime_home:
+        print(f"  prime home       : {state.prime_home}")
+    if state.note:
+        print(f"  note             : {state.note}")
+
+
+def cmd_on(args: argparse.Namespace) -> int:
+    # Issue (or reuse) the dedicated Prime-scoped key. `polli login`
+    # exposes the same flow interactively; here we use the library
+    # entry so `polli harness prime on` works headlessly.
+    api_key = ensure_scoped_key(scope=PRIME_KEY_SCOPE)
+    state = install(
+        api_key=api_key,
+        default_model=args.default_model,
+        refresh_skill=not args.keep_skill,
+    )
+    if not state.installed:
+        print("Prime Agent was not found on this machine.")
+        print("Install it first:")
+        print(f"  {PRIME_INSTALL_URL}")
+        print("then re-run: polli harness prime on")
+        return 2
+    print(f"Pollinations is ready for Prime at {state.prime_home}")
+    print(f"  default model : {state.default_model}")
+    print(f"  available     : {', '.join(state.available_models)}")
+    print("Run `polli harness prime status` at any time to inspect.")
+    return 0
+
+
+def cmd_off(args: argparse.Namespace) -> int:
+    state = uninstall(revoke_key=not args.keep_key)
+    print("Pollinations disconnected from Prime.")
+    if state.prime_home:
+        print(f"  Prime home untouched: {state.prime_home}")
+    if args.keep_key:
+        print("  (key kept; rotate manually with "
+              "`polli login --scope prime-agent --rotate`)")
+    return 0
+
+
+def cmd_status(args: argparse.Namespace) -> int:
+    state = status_fn()
+    _format_state(state)
+    # Exit code makes this scriptable: 0 = ready, 1 = not ready, 2 = Prime
+    # missing entirely.
+    if state.prime_home is None:
+        return 2
+    return 0 if state.installed else 1
+
+
+def cmd_models(args: argparse.Namespace) -> int:
+    """Convenience: list currently compatible Pollinations models.
+
+    Mirrors `status` but focused on models; useful in docs and shell
+    completion.
+    """
+    print("Currently compatible Pollinations models for Prime:")
+    default = default_model_id()
+    for m in SUPPORTED_MODELS:
+        marker = " (default)" if m.id == default else ""
+        print(f"  {m.id:<10} {m.label}{marker}")
+    return 0
+
+
+def register(sub: argparse._SubParsersAction) -> None:
+    """Register the `prime` subtree under `polli harness`."""
+    p = sub.add_parser(
+        "prime",
+        help="Manage the Pollinations <-> Prime Agent integration.",
+        description=(
+            "Install, inspect, or disconnect Pollinations as a Prime "
+ "Agent custom provider. Non-destructive: existing Prime state "
+            "is always preserved."
+        ),
+    )
+    sub2 = p.add_subparsers(dest="prime_action", required=True)
+
+    on = sub2.add_parser("on", help="Install or refresh the integration.")
+    on.add_argument(
+        "--default-model",
+        choices=model_choices(),
+        default=default_model_id(),
+        help="Default Pollinations model for Prime.",
+    )
+    on.add_argument(
+        "--keep-skill",
+        action="store_true",
+        help="Do not overwrite an existing polli skill.",
+    )
+    on.set_defaults(func=cmd_on)
+
+    off = sub2.add_parser("off", help="Disconnect Pollinations from Prime.")
+    off.add_argument(
+        "--keep-key",
+        action="store_true",
+        help="Do not revoke the dedicated Prime key.",
+    )
+    off.set_defaults(func=cmd_off)
+
+    st = sub2.add_parser("status", help="Report integration readiness.")
+    st.set_defaults(func=cmd_status)
+
+    models = sub2.add_parser("models", help="List compatible models.")
+    models.set_defaults(func=cmd_models)
+
+
+__all__ = ["register"]
