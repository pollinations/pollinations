+        if state.prime_home is None:
+            print("Prime Agent not detected; the key is still valid. "
+                  "Install Prime, then run `polli harness prime on`.")
+        else:
+            print(f"Prime detected at {state.prime_home}. "
+                  "Run `polli harness prime on` to wire it up.")
     return 0
