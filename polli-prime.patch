+"""Pollinations <-> Prime Agent integration.
+
+Registers Pollinations as a Prime *custom provider* and installs a
+thin `polli` skill so the agent can route requests through it. Prime's
+continual-agent state (sessions, memories, unrelated skills and
+config) is never mutated: every change is additive, idempotent, and
+reversible via `polli harness prime off`.
+"""
+from .installer import install, uninstall, status, IntegrationState, PrimeHome
+
+__all__ = [
+    "install", "uninstall", "status",
+    "IntegrationState", "PrimeHome",
+]
