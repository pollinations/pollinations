{
    "name": "pollinations.ai",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "test": "tsx --test test/*.test.ts",
        "build": "tsc && vite build",
        "build:staging": "CLOUDFLARE_ENV=staging vite build --mode=staging",
        "build:production": "CLOUDFLARE_ENV=production vite build --mode=production",
        "preview": "vite preview",
        "deploy:staging": "npm run build:staging && wrangler deploy --config dist/pollinations_ai/wrangler.json",
        "deploy:production": "npm run build:production && wrangler deploy --config dist/pollinations_ai/wrangler.json"
    },
    "dependencies": {
        "@tanstack/react-router": "^1.139.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.553.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-markdown": "^10.1.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.15.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/router-plugin": "^1.139.3",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.6",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.0.4",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "tailwindcss": "^4.3.3",
        "tsx": "4.20.6",
        "typescript": "^5.9.3",
        "vite": "^7.1.7",
        "vite-plugin-svgr": "^4.5.0",
        "vite-tsconfig-paths": "^5.1.4",
        "wrangler": "^4.49.0"
    }
}
